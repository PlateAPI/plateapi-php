{
    "name": "plateapi/plateapi-php",
    "description": "PHP SDK for PlateAPI -- Australian vehicle registration plate lookup",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WolfStack Solutions"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
