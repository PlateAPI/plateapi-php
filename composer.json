{
    "name": "plateapi/plateapi-php",
    "description": "PHP SDK for PlateAPI -- Australian vehicle registration plate lookup and vehicle database",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WolfStack Solutions"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "PlateAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlateAPI\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "keywords": [
        "plateapi",
        "rego",
        "vehicle",
        "registration",
        "australia",
        "api",
        "plate-lookup",
        "vehicle-database"
    ],
    "homepage": "https://plateapi.com.au",
    "support": {
        "email": "support@plateapi.com.au",
        "docs": "https://plateapi.com.au/docs/"
    },
    "scripts": {
        "test": "phpunit"
    }
}
